# MeshTopo Environment Variables Example
# Copy this file to .env and modify as needed

# MQTT Broker Settings
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=meshtopo_user
MQTT_PASSWORD=your_secure_password

# Internal MQTT Broker Auth (for mosquitto service)
MQTT_BROKER_USERNAME=meshtopo
MQTT_BROKER_PASSWORD=secure_password

# CalTopo Settings
CALTOPO_CONNECT_KEY=G3rvY...
CALTOPO_GROUP=SARTEAM

# Web UI Settings
WEB_ADMIN_PASSWORD=admin_secret_password
MULTI_TENANT_ENABLED=false

# Persistence Settings
STORAGE_DB_PATH=/app/data/meshtopo_state.sqlite
UNKNOWN_DEVICES_ALL_TENANTS=false

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
